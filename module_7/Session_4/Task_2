import 'package:flutter/material.dart';

class HomeScreen extends StatefulWidget {
  HomeScreen({super.key});

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  String team = "Chennai Super Kings";

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text("My IPL Team")),
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Text("Favorite Team: $team"),
            ElevatedButton(
              onPressed: () async {
                var result = await Navigator.push(
                  context,
                  MaterialPageRoute(builder: (context) => SelectTeamScreen()),
                );
                if (result != null) setState(() => team = result);
              },
              child: Text("Change Team"),
            ),
          ],
        ),
      ),
    );
  }
}

class SelectTeamScreen extends StatelessWidget {
  var teams = ["CSK", "MI", "RCB", "KKR", "GT", "RR"];

  SelectTeamScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text("Select Team")),
      body: ListView.builder(
        itemCount: teams.length,
        itemBuilder: (context, index) => ListTile(
          title: Text(teams[index]),
          onTap: () => Navigator.pop(context, teams[index]),
        ),
      ),
    );
  }
}
